NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=your-neo4j-user
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Dynamic Text-to-Cypher must use a separate Neo4j account with read-only privileges.
NEO4J_QUERY_URI=neo4j://localhost:7687
NEO4J_QUERY_USER=your-read-only-neo4j-user
NEO4J_QUERY_PASSWORD=
NEO4J_QUERY_DATABASE=neo4j

# Raw questions are not written to runtime traces unless explicitly opted in.
KG_QUERY_TRACE_RAW_QUESTION=false
KG_QUERY_TRACE_FINGERPRINT=false
KG_QUERY_TRACE_HMAC_KEY=
KG_QUERY_TRACE_RETENTION_DAYS=30

# Local Ollama endpoint only; model files and caches stay outside this repository.
KG_LLM_BASE_URL=http://127.0.0.1:11434
KG_LLM_MODEL=qwen2.5-coder:14b
KG_LLM_TIMEOUT_SECONDS=180
KG_LLM_MAX_RETRIES=1
KG_LLM_TEMPERATURE=0
KG_LLM_CONTEXT_LENGTH=8192
